# Copie para .env.local e preencha.

# sanity.io/manage → seu projeto → "Project ID"
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Segredo do webhook de revalidação (qualquer texto longo e aleatório).
# Use o mesmo valor no webhook configurado no Sanity.
SANITY_REVALIDATE_SECRET=

# ---------- Painel (/painel) ----------
# Chave de escrita do Sanity, SÓ no servidor (sanity.io/manage → API → Tokens, permissão Editor).
SANITY_WRITE_TOKEN=

# Login com Google (console.cloud.google.com/auth/clients → Criar cliente → Aplicativo da Web).
# A chave secreta só aparece uma vez, ao criar o cliente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo que criptografa a sessão. Gere com: npx auth secret   (ou: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Endereço do site. Local: http://localhost:3000   Vercel (produção): https://ibp-curitiba.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Quem pode entrar: "email:papel,email:papel" (papel = admin ou editor).
PAINEL_ACESSOS=
